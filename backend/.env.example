# ── Django core ────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False

# ── Hosts & URLs ───────────────────────────────────────────────────────────────
# Comma-separated. Include your domain without protocol.
ALLOWED_HOSTS=tammo.in,www.tammo.in,localhost,127.0.0.1

FRONTEND_URL=https://tammo.in

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated HTTPS origins that the browser frontend runs on.
# Dev origins (localhost:5173 etc.) are always included automatically.
CORS_ALLOWED_ORIGINS_EXTRA=https://tammo.in,https://www.tammo.in

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Public Client ID from Google Cloud Console — safe to put here.
# Must match the VITE_GOOGLE_CLIENT_ID used in the React build.
GOOGLE_CLIENT_ID=173907682716-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Email (Gmail SMTP example) ─────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=Your Store <your@gmail.com>
BUSINESS_EMAIL=admin@yourstore.com
